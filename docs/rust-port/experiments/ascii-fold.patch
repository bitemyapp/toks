+//! Operations on the fixed, padded 16-byte keys used by shortcut tables.
+
+/// Lowercase ASCII A–Z, retaining every other byte (including the zero padding).
+/// SSE2 and NEON are baseline features of the two supported 64-bit targets.
+#[inline(always)]
+pub(crate) fn lowercase_key(words: [u64; 2]) -> [u64; 2] {
+    #[cfg(target_arch = "aarch64")]
+    unsafe {
+        use std::arch::aarch64::*;
+        let bytes: uint8x16_t = std::mem::transmute(words);
+        let upper = vandq_u8(
+            vcgeq_u8(bytes, vdupq_n_u8(b'A')),
+            vcleq_u8(bytes, vdupq_n_u8(b'Z')),
+        );
+        std::mem::transmute(vorrq_u8(bytes, vandq_u8(upper, vdupq_n_u8(0x20))))
+    }
+    #[cfg(target_arch = "x86_64")]
+    unsafe {
+        use std::arch::x86_64::*;
+        let bytes: __m128i = std::mem::transmute(words);
+        // Signed comparisons exclude bytes >= 128 from the first mask.
+        let upper = _mm_and_si128(
+            _mm_cmpgt_epi8(bytes, _mm_set1_epi8((b'A' - 1) as i8)),
+            _mm_cmpgt_epi8(_mm_set1_epi8((b'Z' + 1) as i8), bytes),
+        );
+        std::mem::transmute(_mm_or_si128(
+            bytes,
+            _mm_and_si128(upper, _mm_set1_epi8(0x20)),
+        ))
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn check(bytes: [u8; 16]) {
+        let words = [
+            u64::from_le_bytes(bytes[..8].try_into().unwrap()),
+            u64::from_le_bytes(bytes[8..].try_into().unwrap()),
+        ];
+        let got = lowercase_key(words);
+        let expected = bytes.map(|b| if b.is_ascii_uppercase() { b + 32 } else { b });
+        assert_eq!(got[0].to_le_bytes(), expected[..8]);
+        assert_eq!(got[1].to_le_bytes(), expected[8..]);
+    }
+
+    #[test]
+    fn ascii_folding_preserves_all_other_bytes() {
+        for value in 0..=255 {
+            check([value; 16]);
+            for position in 0..16 {
+                let mut bytes = *b"AZ[az{09@\0\x7f\x80\xffBCz";
+                bytes[position] = value;
+                check(bytes);
+            }
+        }
+        let mut state = 0x73ce_1d96_4825_abf0u64;
+        for _ in 0..10000 {
+            let mut bytes = [0; 16];
+            for b in &mut bytes {
+                state ^= state << 13;
+                state ^= state >> 7;
+                state ^= state << 17;
+                *b = state as u8;
+            }
+            check(bytes);
+        }
+    }
+}
